@model BookingMovieTicket.Models.Rap
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}

<header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="h2 fw-bold text-dark">Danh sách Rạp</h2>
    </div>
    <div class="d-flex align-items-center gap-3">
        <a asp-action="them" class="btn btn-primary d-flex align-items-center">
            <span class="material-icons me-2">add</span>
            Thêm Rạp Mới
        </a>
    </div>
</header>

<!-- Thanh tìm kiếm -->
<div class="bg-white border-bottom p-4">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <div class="flex-grow-1">
            <input type="text"
                   name="tuKhoa"
                   class="form-control"
                   placeholder="Tìm theo Mã rạp, Tên rạp, Địa chỉ hoặc Trạng thái..."
                   value="@ViewBag.TuKhoa" />
        </div>
        <button type="submit" class="btn btn-primary d-flex align-items-center">
            <span class="material-icons me-2">search</span>
            Tìm kiếm
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
        {
            <a asp-action="Index" class="btn btn-secondary d-flex align-items-center">
                <span class="material-icons me-2">clear</span>
                Xóa lọc
            </a>
        }
    </form>
</div>

<!-- Thông báo lỗi tìm kiếm nếu có -->
@if (!string.IsNullOrWhiteSpace(ViewBag.LoiTimKiem))
{
    <div class="alert alert-danger alert-dismissible fade show m-4" role="alert">
        <span class="material-icons align-middle me-2">error</span>
        <strong>Lỗi:</strong> @ViewBag.LoiTimKiem
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thông báo thành công (từ Thêm/Sửa/Xóa) -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-4" role="alert">
        <span class="material-icons align-middle me-2">check_circle</span>
        <strong>Thành công:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="flex-grow-1 overflow-auto p-4">
    <div class="bg-white rounded shadow-sm overflow-hidden">
        @if (ViewBag.qlr != null && ViewBag.qlr.Count > 0)
        {
            <!-- Thông báo số lượng kết quả -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
            {
                <div class="alert alert-info m-3">
                    <span class="material-icons align-middle me-2">info</span>
                    Tìm thấy <strong>@ViewBag.qlr.Count</strong> kết quả cho từ khóa "<strong>@ViewBag.TuKhoa</strong>"
                </div>
            }

            <table class="table table-bordered align-middle text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th>Mã Rạp</th>
                        <th>Tên Rạp</th>
                        <th>Địa chỉ</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.qlr)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MaRap</td>
                            <td class="fw-semibold">@item.TenRap</td>
                            <td>@item.DiaChi</td>
                            <td>@item.TrangThai</td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="sua" asp-route-id="@item.MaRap" class="btn btn-success btn-sm">Sửa</a>
                                    <a asp-action="xoa" asp-route-id="@item.MaRap" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning m-3" role="alert">
                <span class="material-icons align-middle me-2">warning</span>
                @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
                {
                    <span>Không tìm thấy kết quả nào với từ khóa "<strong>@ViewBag.TuKhoa</strong>"</span>
                }
                else
                {
                    <span>Chưa có dữ liệu rạp</span>
                }
            </div>
        }
    </div>
</div>


@model BookingMovieTicket.Models.Phim
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}

<header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="h2 fw-bold text-dark">Danh sách Phim</h2>
    </div>
    <div class="d-flex align-items-center gap-3">
        <a asp-action="them" class="btn btn-primary d-flex align-items-center">
            <span class="material-icons me-2">add</span>
            Thêm Phim Mới
        </a>
    </div>
</header>

<!-- Thanh tìm kiếm -->
<div class="bg-white border-bottom p-4">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <div class="flex-grow-1">
            <input type="text"
                   name="tuKhoa"
                   class="form-control"
                   placeholder="Tìm theo Mã phim, Tên phim, Đạo diễn hoặc Đánh giá..."
                   value="@ViewBag.TuKhoa" />
        </div>
        <button type="submit" class="btn btn-primary d-flex align-items-center">
            <span class="material-icons me-2">search</span>
            Tìm kiếm
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
        {
            <a asp-action="Index" class="btn btn-secondary d-flex align-items-center">
                <span class="material-icons me-2">clear</span>
                Xóa lọc
            </a>
        }
    </form>
</div>

<!-- Thông báo lỗi tìm kiếm nếu có -->
@if (!string.IsNullOrWhiteSpace(ViewBag.LoiTimKiem))
{
    <div class="alert alert-danger alert-dismissible fade show m-4" role="alert">
        <span class="material-icons align-middle me-2">error</span>
        <strong>Lỗi:</strong> @ViewBag.LoiTimKiem
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thông báo thành công (từ Thêm/Sửa/Xóa) -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show m-4" role="alert">
        <span class="material-icons align-middle me-2">check_circle</span>
        <strong>Thành công:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="flex-grow-1 overflow-auto p-4">
    <div class="bg-white rounded shadow-sm overflow-hidden">
        @if (ViewBag.qlp != null && ViewBag.qlp.Count > 0)
        {
            <!-- Thông báo số lượng kết quả -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
            {
                <div class="alert alert-info m-3">
                    <span class="material-icons align-middle me-2">info</span>
                    Tìm thấy <strong>@ViewBag.qlp.Count</strong> kết quả cho từ khóa "<strong>@ViewBag.TuKhoa</strong>"
                </div>
            }

            <table class="table table-bordered align-middle text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th><label asp-for="MaPhim" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="TenPhim" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="MoTa" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="ThoiLuong" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="DaoDien" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="DanhGia" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="NgayPhatHanh" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="Trailer" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th><label asp-for="Poster" class="text-muted small text-uppercase fw-semibold"></label></th>
                        <th class="text-muted small text-uppercase fw-semibold">Tác vụ</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in ViewBag.qlp)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MaPhim</td>
                            <td class="fw-semibold">@item.TenPhim</td>
                            <td class="text-muted text-truncate" style="max-width: 200px;">@item.MoTa</td>
                            <td>@item.ThoiLuong phút</td>
                            <td>@item.DaoDien</td>
                            <td>@item.DanhGia</td>
                            <td>@item.NgayPhatHanh?.ToShortDateString()</td>
                            <td><a href="@item.Trailer" class="text-primary text-decoration-underline" target="_blank">Xem</a></td>
                            <td><img class="img-thumbnail" style="height: 96px; width: auto;" src="@item.Poster" /></td>

                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="sua" asp-route-id="@item.MaPhim" class="btn btn-success btn-sm">
                                        Sửa
                                    </a>
                                    <a asp-action="xoa" asp-route-id="@item.MaPhim" class="btn btn-danger btn-sm">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning m-3" role="alert">
                <span class="material-icons align-middle me-2">warning</span>
                @if (!string.IsNullOrWhiteSpace(ViewBag.TuKhoa))
                {
                    <span>Không tìm thấy kết quả nào với từ khóa "<strong>@ViewBag.TuKhoa</strong>"</span>
                }
                else
                {
                    <span>Chưa có dữ liệu phim</span>
                }
            </div>
        }
    </div>
</div>

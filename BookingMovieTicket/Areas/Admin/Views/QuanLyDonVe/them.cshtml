@using BookingMovieTicket.Models
@model BookingMovieTicket.Models.DonDatVe
@using BookingMovieTicket.ViewModels;
@{
    ViewData["Title"] = "them";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h2 fw-bold text-dark">Thêm Đơn Vé mới</h2>
        </div>
    </header>
    <br />
    <div class="container">
        <form asp-action="them" method="post" enctype="multipart/form-data" asp-area="Admin">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col">
                    <label asp-for="MaDon" class="form-label"></label>
                    <input asp-for="MaDon" class="form-control" />
                    <span asp-validation-for="MaDon" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MaNd" class="form-label">Người Dùng</label>
                    <select asp-for="MaNd" asp-items="ViewBag.DSND" class="form-select">
                        <option value="">-- Chọn ND --</option>
                    </select>
                    <span asp-validation-for="MaNd" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ThoiGianDat" class="control-label"></label>
                    <input asp-for="ThoiGianDat" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ThoiGianDat" class="text-danger"></span>
                </div>
                <select asp-for="TrangThai" class="form-select">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="Đã hủy">Đã hủy</option>
                    <option value="Đã thanh toán">Đã thanh toán</option>
                </select>
            </div>
            <div class="form-group mt-3">
                <input type="submit" class="btn btn-primary" value="Save" />
            </div>
            <div>
                <a asp-action="Index">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>








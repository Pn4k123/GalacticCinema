@using BookingMovieTicket.Models
@model BookingMovieTicket.Models.DonDatVe

@{
    ViewData["Title"] = "Sửa Đơn Vé";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header class="bg-white border-bottom p-4">
        <h2 class="h2 fw-bold text-dark">Cập nhật Đơn Vé</h2>
    </header>

    <div class="container mt-4">
        <form asp-action="sua" method="post" asp-area="Admin">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "display:block")">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MaDon" class="form-label fw-bold">Mã Đơn</label>
                    <input asp-for="MaDon" class="form-control bg-light" readonly />
                    <span asp-validation-for="MaDon" class="text-danger"></span>
                    <small class="text-muted">Không thể thay đổi mã đơn.</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MaNd" class="form-label fw-bold">Người Dùng</label>
                    <select asp-for="MaNd" asp-items="ViewBag.DSND" class="form-select">
                        <option value="">-- Chọn Người Dùng --</option>
                    </select>
                    <span asp-validation-for="MaNd" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ThoiGianDat" class="form-label fw-bold">Thời Gian Đặt</label>
                    <input asp-for="ThoiGianDat" type="datetime-local" class="form-control" />
                    <span asp-validation-for="ThoiGianDat" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TrangThai" class="form-label fw-bold">Trạng Thái</label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="">-- Chọn trạng thái --</option>

                        <option value="Đã hủy">Đã hủy</option>
                        <option value="Đã thanh toán">Đã thanh toán</option>
                        <option value="Chưa thanh toán">Chưa thanh toán</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <input type="submit" class="btn btn-primary me-2" value="Lưu thay đổi" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>
@model BookingMovieTicket.Models.Phim
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
    ViewData["Title"] = "Dashboard";
}
@{
    QuanLyDatVePhimContext db = new QuanLyDatVePhimContext();
    int tongPhim = db.Phims.Count();
    decimal tongDoanhThu = db.ChiTietDonDatVes.Sum(ct => ct.GiaVe);
    int tongKH = db.NguoiDungs.Where(k => k.MaNd.StartsWith("KH")).Count();
    int tongVeBan = db.DonDatVes.Where(d => d.TrangThai == "Đã thanh toán").Count();
}

<header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold mb-3">Dashboard</h3>
        <h6 class="op-7 mb-2">Tổng quan nhanh về hệ thống của bạn</h6>
    </div>
</header>

<div class="page-inner">

    <div class="row">
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-primary card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="fas fa-dollar-sign"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">Doanh thu (VND)</p>
                                <h4 class="card-title">@tongDoanhThu</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-info card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">Người dùng</p>
                                <h4 class="card-title">@tongKH</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-success card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="fas fa-ticket-alt"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">Vé đã bán</p>
                                <h4 class="card-title">@tongVeBan</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-secondary card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="fas fa-film"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">Phim đang chiếu</p>
                                <h4 class="card-title">
                                    @{
                                        @tongPhim;
                                    }
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@using Microsoft.EntityFrameworkCore
@model BookingMovieTicket.Models.Phim
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
    ViewData["Title"] = "Dashboard";
}
@{
    QuanLyDatVePhimContext db = new QuanLyDatVePhimContext();
    int tongPhim = db.Phims.Count();
    decimal tongDoanhThu = db.ChiTietDonDatVes.Sum(ct => ct.GiaVe);
    int tongKH = db.NguoiDungs.Where(k => k.MaNd.StartsWith("KH")).Count();
    int tongVeBan = db.DonDatVes.Where(d => d.TrangThai == "Đã thanh toán").Count();
    var topPhims = ViewBag.topPhims;
    var donHangMoi = ViewBag.donHangMoi;
}

<style>
    /* Card chung */
    .card-modern {
        border: none;
        border-radius: 16px; /* Bo góc mềm mại */
        background-color: #fff;
        box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.05); /* Đổ bóng nhẹ */
        transition: all 0.3s ease; /* Hiệu ứng mượt mà */
        position: relative;
        overflow: hidden;
    }

        /* Hiệu ứng khi di chuột */
        .card-modern:hover {
            transform: translateY(-5px); /* Nổi lên trên */
            box-shadow: 0 10px 25px 0 rgba(0, 0, 0, 0.1);
        }

    /* Container chứa Icon */
    .icon-shape {
        width: 56px;
        height: 56px;
        border-radius: 12px; /* Bo góc icon */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #fff;
        box-shadow: 0 4px 10px 0 rgba(0, 0, 0, 0.2);
    }

    /* Các màu Gradient cho Icon */
    .bg-gradient-primary {
        background: linear-gradient(45deg, #1572e8, #48abf7);
    }
    /* Xanh dương */
    .bg-gradient-success {
        background: linear-gradient(45deg, #31ce36, #74eb78);
    }
    /* Xanh lá */
    .bg-gradient-danger {
        background: linear-gradient(45deg, #f25961, #ff9ca0);
    }
    /* Đỏ/Cam */
    .bg-gradient-warning {
        background: linear-gradient(45deg, #ffad46, #ffcf87);
    }
    /* Vàng/Cam */
    .bg-gradient-info {
        background: linear-gradient(45deg, #6861ce, #938ce8);
    }
    /* Tím */

    /* Typography */
    .card-category {
        font-size: 14px;
        font-weight: 600;
        color: #8d9498;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-number {
        font-size: 24px;
        font-weight: 800;
        color: #1a2035;
        margin-bottom: 0;
    }

    /* Trang trí thêm hình mờ phía sau (Optional) */
    .card-overlay-icon {
        position: absolute;
        right: -10px;
        bottom: -10px;
        font-size: 100px;
        opacity: 0.05;
        transform: rotate(-15deg);
        pointer-events: none;
    }
</style>

<header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold mb-3">Dashboard</h3>
        <h6 class="op-7 mb-2">Tổng quan nhanh về hệ thống của bạn</h6>
    </div>
</header>

<div class="page-inner">

    <div class="row mt-4">
        <div class="col-sm-6 col-md-3">
            <div class="card card-modern">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="card-category">Tổng Doanh Thu</p>
                            <h4 class="card-number text-success">@tongDoanhThu.ToString("N0") <small style="font-size: 14px">đ</small></h4>
                        </div>
                        <div class="icon-shape bg-gradient-success">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                    <i class="fas fa-dollar-sign card-overlay-icon text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="card card-modern">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="card-category">Vé Đã Bán</p>
                            <h4 class="card-number">@tongVeBan</h4>
                        </div>
                        <div class="icon-shape bg-gradient-warning">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                    </div>
                    <i class="fas fa-ticket-alt card-overlay-icon text-warning"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="card card-modern">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="card-category">Khách Hàng</p>
                            <h4 class="card-number">@tongKH</h4>
                        </div>
                        <div class="icon-shape bg-gradient-primary">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                    <i class="fas fa-users card-overlay-icon text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="card card-modern">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="card-category">Phim Đang Chiếu</p>
                            <h4 class="card-number">@tongPhim</h4>
                        </div>
                        <div class="icon-shape bg-gradient-info">
                            <i class="fas fa-film"></i>
                        </div>
                    </div>
                    <i class="fas fa-film card-overlay-icon text-info"></i>
                </div>
            </div>
        </div>
    </div>

        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Biểu đồ doanh thu 7 ngày qua</div>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Top Phim Hot</div>
                    </div>
                    <div class="card-body pb-0">
              
                        @foreach (var phim in topPhims)
                        {
                            <div class="d-flex align-items-center pb-2 mb-2 border-bottom">
                                <div class="me-3">
                                    <img src="@phim.Hinh"
                                         alt="@phim.TenPhim"
                                         class="rounded shadow-sm"
                                         style="width: 70px; height: 105px; object-fit: cover;" />
                                </div>
                                <div class="flex-1 ms-3">
                                    <h6 class="fw-bold mb-1" style="max-width: 200px;">@phim.TenPhim</h6>
                                    <small class="text-muted">Doanh thu: <span class="text-success fw-bold">@phim.DoanhThu.ToString("N0") đ</span></small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Đơn đặt vé mới nhất</div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Khách hàng</th>
                                        <th>Thời gian</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in donHangMoi)
                                    {
                                        
                                        string badgeClass = "bg-secondary"; 
                                        string trangThaiText = string.IsNullOrEmpty(item.TrangThai) ? "Chưa xác định" : item.TrangThai;

                                        if (item.TrangThai == "Đã thanh toán")
                                        {
                                            badgeClass = "bg-success"; 
                                        }
                                        else if (item.TrangThai == "Đang chờ")
                                        {
                                            badgeClass = "bg-warning text-dark"; 
                                        }
                                        else if (item.TrangThai == "Đã hủy")
                                        {
                                            badgeClass = "bg-danger"; 
                                        }

                                        <tr>
                                            <td>@item.MaDon</td>
                                            <td>@item.TenND</td>
                                            <td>@item.ThoiGianDat.ToString("dd/MM/yyyy HH:mm")</td>

                                            <td class="fw-bold text-primary">@item.tongTien.ToString("N0") đ</td>

                                            <td>
                                                <span class="badge @badgeClass">
                                                    @trangThaiText
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
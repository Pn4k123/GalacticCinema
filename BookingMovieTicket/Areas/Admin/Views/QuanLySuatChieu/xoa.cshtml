@model BookingMovieTicket.Models.SuatChieu

@{
    ViewData["Title"] = "Xóa Suất Chiếu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header class="bg-white border-bottom p-4">
        <h2 class="h2 fw-bold text-danger">Xóa Suất Chiếu</h2>
        <h5 class="text-muted">Bạn có chắc chắn muốn xóa suất chiếu này không?</h5>
        <p class="text-secondary small">
            Lưu ý: Không thể xóa nếu suất chiếu này đã phát sinh Vé đặt.
        </p>
    </header>

    <div class="container mt-4">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"
             style="@(ViewData.ModelState.IsValid ? "display:none" : "display:block")">
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Mã Suất Chiếu:</dt>
                    <dd class="col-sm-9 fw-bold">@Model.MaSuatChieu</dd>

                    <dt class="col-sm-3">Phim:</dt>
                    <dd class="col-sm-9">
                        @Model.MaPhimNavigation?.TenPhim
                        <span class="text-muted small">(@Model.MaPhim)</span>
                    </dd>

                    <dt class="col-sm-3">Phòng:</dt>
                    <dd class="col-sm-9">
                        @Model.MaPhongNavigation?.TenPhong
                        <span class="text-muted small">(@Model.MaPhong)</span>
                    </dd>

                    <dt class="col-sm-3">Thời gian:</dt>
                    <dd class="col-sm-9 fw-bold text-primary">
                        @Model.NgayChieu.ToString("dd/MM/yyyy") - @Model.GioChieu
                    </dd>

                    <dt class="col-sm-3">Trạng Thái:</dt>
                    <dd class="col-sm-9">
                        @if (Model.TrangThai == "Sắp chiếu")
                        {
                            <span class="badge bg-primary">@Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Đang chiếu")
                        {
                            <span class="badge bg-success">@Model.TrangThai</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.TrangThai</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="xoa" method="post">
            <input type="hidden" asp-for="MaSuatChieu" />

            <input type="submit" value="Xác nhận xóa" class="btn btn-danger me-2" />
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </form>
    </div>
</body>
</html>
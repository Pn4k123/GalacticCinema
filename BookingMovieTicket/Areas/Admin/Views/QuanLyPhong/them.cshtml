@using BookingMovieTicket.Models
@model BookingMovieTicket.Models.Phong
@using BookingMovieTicket.ViewModels;

@{
    ViewData["Title"] = "them";
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h2 fw-bold text-dark">Thêm phòng mới</h2>
        </div>
    </header>
    <br />
    <div class="container">
        <form asp-action="them" method="post" enctype="multipart/form-data" asp-area="Admin">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col">
                    <label asp-for="MaPhong" class="form-label"></label>
                    <input asp-for="MaPhong" class="form-control" />
                    <span asp-validation-for="MaPhong" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaRap" class="form-label">Rạp</label>
                    <select asp-for="MaRap" asp-items="ViewBag.DSRap" class="form-select">
                        <option value="">-- Chọn rạp --</option>
                    </select>
                    <span asp-validation-for="MaRap" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenPhong" class="control-label"></label>
                    <input asp-for="TenPhong" class="form-control" />
                    <span asp-validation-for="TenPhong" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TrangThai" class="control-label"></label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="">-- Chọn trạng thái --</option>
                        <option value="Hoạt động">Hoạt động</option>
                        <option value="Không hoạt động">Không hoạt động</option>
                    </select>                    
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group mt-3">
                <input type="submit" class="btn btn-primary" value="Save" />
            </div>
            <div>
                <a asp-action="Index">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>


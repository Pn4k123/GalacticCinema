@model BookingMovieTicket.Models.NguoiDung
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout_Admin.cshtml";
}
<header class="bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="h2 fw-bold text-dark">Danh sách tài khoản</h2>
    </div>
    <div class="d-flex align-items-center gap-3">
        <a asp-action="them" class="btn btn-primary d-flex align-items-center">
            <span class="material-icons me-2">add</span>
            Thêm Người dùng Mới
        </a>
    </div>
</header>

<div class="flex-grow-1 overflow-auto p-4">
    <div class="bg-white rounded shadow-sm overflow-hidden">

        <table class="table table-bordered align-middle text-nowrap">
            <thead class="table-light">
                <tr>
                    <th><label asp-for="MaNd" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th><label asp-for="HoTen" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th><label asp-for="Email" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th><label asp-for="GioiTinh" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th><label asp-for="NgaySinh" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th><label asp-for="Sdt" class="text-muted small text-uppercase fw-semibold"></label></th>
                    <th class="text-muted small text-uppercase fw-semibold">Tác vụ</th>
                </tr>
            </thead>

            <tbody>
                @{
                    foreach (var item in ViewBag.qltk)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MaNd</td>
                            <td class="fw-semibold">@item.HoTen</td>
                            <td>@item.Email</td>
                            <td>
                                @{
                                    if(item.GioiTinh == 1)
                                    {
                                        <p>Nam</p>
                                    }
                                    else
                                    {
                                        <p>Nữ</p>
                                    }
                                }
                            </td>
                            <td>@item.NgaySinh.ToShortDateString()</td>
                            <td>@item.Sdt</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="sua" asp-route-id="@item.MaNd" class="btn btn-success btn-sm">
                                        Sửa
                                    </a>
                                    <a asp-action="xoa" asp-route-id="@item.MaNd" class="btn btn-danger btn-sm">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>

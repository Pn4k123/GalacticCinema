@using BookingMovieTicket.ViewModels
@{
    ViewData["Title"] = "Trang Chủ";
    Phim phim = ViewBag.tenPhim;
    Rap rap = ViewBag.tenRap;
}

<!-- ========== HERO CAROUSEL ========== -->
<section class="gc-section animate-fadeInUp">
    <div id="heroCarousel" class="carousel slide gc-hero-carousel" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/hinhanh/banner/2048-zalopay_1756202416336.png" class="d-block w-100" alt="Banner Khuyến Mãi ZaloPay">
            </div>
            <div class="carousel-item">
                <img src="~/hinhanh/banner/lio-t9-galaxy-banner-app-2048x682_1758894535113.jpg" class="d-block w-100" alt="Banner Galaxy">
            </div>
            <div class="carousel-item">
                <img src="~/hinhanh/banner/long-dien-huong-2048_1763019004777.jpg" class="d-block w-100" alt="Banner Phim Mới">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>

<!-- ========== QUICK BOOKING (MUA VÉ NHANH) ========== -->
<section class="gc-section animate-fadeInUp animate-delay-1">
    <div class="gc-quick-booking">
        <h3 class="gc-quick-booking-title mb-4">
            <span class="icon"><i class="fas fa-ticket-alt"></i></span>
            MUA VÉ NHANH
        </h3>
        <form>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="movieSelect" class="gc-form-label">
                        <i class="fas fa-film me-1"></i> Chọn Phim
                    </label>
                    <select asp-for="@phim.TenPhim" asp-items="ViewBag.DSPhim" class="form-select gc-form-control" id="movieSelect">
                        <option selected="selected">Chọn phim</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="cinemaSelect" class="gc-form-label">
                        <i class="fas fa-building me-1"></i> Chọn Rạp
                    </label>
                    <select asp-for="@rap.TenRap" asp-items="ViewBag.DSRapSelectList" class="form-select gc-form-control" id="cinemaSelect">
                        <option selected="selected">Chọn rạp</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="dateSelect" class="gc-form-label">
                        <i class="fas fa-calendar-alt me-1"></i> Chọn Ngày
                    </label>
                    <input type="date" class="form-control gc-form-control" id="dateSelect">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="gc-btn-buy w-100">
                        <i class="fas fa-shopping-cart"></i> Mua Vé Ngay
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- ========== PHIM ĐANG CHIẾU / SẮP CHIẾU ========== -->
<section class="gc-section animate-fadeInUp animate-delay-2">
    <!-- Movie Tabs -->
    <ul class="nav gc-movie-tabs mb-3" id="movieTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="dang-chieu-tab" data-bs-toggle="tab" data-bs-target="#dang-chieu" type="button" role="tab" aria-controls="dang-chieu" aria-selected="true">
                <i class="fas fa-play-circle me-1"></i> Phim Đang Chiếu
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sap-chieu-tab" data-bs-toggle="tab" data-bs-target="#sap-chieu" type="button" role="tab" aria-controls="sap-chieu" aria-selected="false">
                <i class="fas fa-clock me-1"></i> Phim Sắp Chiếu
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content gc-tab-content" id="movieTabsContent">
        <div class="tab-pane fade show active" id="dang-chieu" role="tabpanel" aria-labelledby="dang-chieu-tab">
            <div class="row g-4">
                @await Component.InvokeAsync("Phim", new { trangthai = "dangchieu" })
            </div>
        </div>
        <div class="tab-pane fade" id="sap-chieu" role="tabpanel" aria-labelledby="sap-chieu-tab">
            <div class="row g-4">
                @await Component.InvokeAsync("Phim", new { trangthai = "sapchieu" })
            </div>
        </div>
    </div>
</section>

<!-- ========== GÓC ĐIỆN ẢNH (BLOG) ========== -->
<section class="gc-section animate-fadeInUp animate-delay-3">
    <div class="gc-section-header">
        <span class="icon"><i class="fas fa-newspaper"></i></span>
        <h2><a href="#">Góc Điện Ảnh</a></h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="gc-blog-card">
                <div class="card-img-wrapper">
                    <span class="gc-badge-review">Review</span>
                    <img src="~/hinhanh/blog/750_1762758603060.jpg" class="card-img-top" alt="Predator Badlands Review">
                </div>
                <div class="card-body">
                    <h5 class="card-title">[Review] Predator Badlands: Sự Hồi Sinh Của Thương Hiệu Quái Thú Lừng Lẫy</h5>
                    <a href="#" class="gc-btn-readmore">
                        Đọc thêm <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="gc-blog-card">
                <div class="card-img-wrapper">
                    <span class="gc-badge-review">Review</span>
                    <img src="~/hinhanh/blog/cuc-vang-cua-ngoai-3_1761022665126.jpg" class="card-img-top" alt="Trái Tim Què Quặt Review">
                </div>
                <div class="card-body">
                    <h5 class="card-title">[Review] Trái Tim Què Quặt: Hai Mối Tình Và Một Vụ Án Mạng</h5>
                    <a href="#" class="gc-btn-readmore">
                        Đọc thêm <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="gc-blog-card">
                <div class="card-img-wrapper">
                    <span class="gc-badge-review">Review</span>
                    <img src="~/hinhanh/blog/review-trai-tim-que-quat-hai-moi-tinh-va-mot-vu-an-mang-7_1762412640089.jpg" class="card-img-top" alt="Cục Vàng Của Ngoại Review">
                </div>
                <div class="card-body">
                    <h5 class="card-title">[Review] Cục Vàng Của Ngoại: Việt Hương - Hồng Đào Lấy Nước Mắt Khán Giả</h5>
                    <a href="#" class="gc-btn-readmore">
                        Đọc thêm <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========== TIN KHUYẾN MÃI ========== -->
<section class="gc-section animate-fadeInUp animate-delay-4">
    <div class="gc-section-header">
        <span class="icon"><i class="fas fa-tags"></i></span>
        <h2><a href="#">Tin Khuyến Mãi</a></h2>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <a href="#" class="d-block">
                <div class="gc-promo-card">
                    <span class="gc-badge-hot"><i class="fas fa-fire me-1"></i> HOT</span>
                    <img src="~/hinhanh/khuyenmai/momo-galaxy-1_1756958473463.jpg" class="img-fluid" alt="Khuyến mãi Momo">
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="#" class="d-block">
                <div class="gc-promo-card">
                    <span class="gc-badge-hot"><i class="fas fa-fire me-1"></i> HOT</span>
                    <img src="~/hinhanh/khuyenmai/zalopay-1_1756131251308.jpg" class="img-fluid" alt="Khuyến mãi ZaloPay">
                </div>
            </a>
        </div>
    </div>
</section>

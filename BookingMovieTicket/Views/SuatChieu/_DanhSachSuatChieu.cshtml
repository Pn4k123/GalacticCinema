@model IEnumerable<BookingMovieTicket.Models.SuatChieu>
<div class="d-flex flex-wrap gap-3">
@foreach(var item in Model){
    {
            <a data-id="@item.MaSuatChieu"
               data-logged="@ViewBag.DaDangNhap.ToString().ToLower()" class="gc-showtime-btn openDon">
        <div class="gc-showtime-time">@item.GioChieu.ToString("HH:mm")</div>
        <small class="gc-showtime-format">2D Phụ Đề</small> <br />
        <small class="gc-showtime-room">@item.MaPhongNavigation.TenPhong</small>
    </a>
    }}
</div>
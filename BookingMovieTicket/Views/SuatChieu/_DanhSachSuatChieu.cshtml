@model IEnumerable<BookingMovieTicket.Models.SuatChieu>
<div class="d-flex flex-wrap gap-3">
@foreach(var item in Model){
    {
            <a data-id="@item.MaSuatChieu"
               data-logged="@ViewBag.DaDangNhap.ToString().ToLower()" class="btn btn-outline-dark py-2 px-3 openDon">
        <div class="fw-bold">@item.GioChieu.ToString("HH:mm")</div>
        <small class="text-muted">2D Phụ Đề</small> <br />
        <small class="text-muted">@item.MaPhongNavigation.TenPhong</small>
    </a>
    }}
</div>
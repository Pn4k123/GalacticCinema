@using BookingMovieTicket.ViewModels
@using Newtonsoft.Json
@model BookingMovieTicket.Models.Phim

@{
    QuanLyDatVePhimContext db = new QuanLyDatVePhimContext();
    ViewBag.DSRap = db.Raps;

    var phimsapchieu = db.Phims.Select(phim => new PhimVM
    {
        MaPhim = phim.MaPhim,
        TenPhim = phim.TenPhim,
        Poster = phim.Poster,
        NgayPhatHanh = phim.NgayPhatHanh
    }).Where(p => p.NgayPhatHanh > DateTime.Now).OrderByDescending(p => p.NgayPhatHanh).Take(4);

    var phimdangchieu = db.Phims.Select(phim => new PhimVM
    {
        MaPhim = phim.MaPhim,
        TenPhim = phim.TenPhim,
        Poster = phim.Poster,
        NgayPhatHanh = phim.NgayPhatHanh
    }).Where(p => p.NgayPhatHanh <= DateTime.Now).OrderByDescending(p => p.NgayPhatHanh).Take(4);

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINEMA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingMovieTicket.styles.css" asp-append-version="true" />

    <style>
        .navbar-nav 
        
        .nav-link:hover {
            color: #ff9900 !important;
        }
        .nav-link a:hover {
            color: #ff9900 !important;
        }

        #openLogin:hover,
        #openRegister:hover {
            color: #ff9900 !important;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light text-bg-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">GALACTIC CINEMA</a>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item dropdown mega-dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownPhim" role="button">
                                Phim
                            </a>

                            <div class="dropdown-menu mega-menu p-3" aria-labelledby="navbarDropdownPhim">
                                <div class="dropdown-item-text fw-bold text-md">Phim đang chiếu</div>
                                <div class="row">
                                    @foreach (var item in phimdangchieu)
                                    {
                                        <div class="col-3">
                                            <div class="card h-100 movie-card position-relative overflow-hidden ">
                                                <img src="@item.Poster" class="card-img-top" alt="@item.TenPhim">
                                                <div class="card-body">
                                                    <h5 class="card-title fw-bold">@item.TenPhim</h5>
                                                    <div class="overlay d-flex flex-column justify-content-center align-items-center gap-2 position-absolute top-0 start-0 w-100 h-100">
                                                        <a asp-controller="Phim" asp-action="Index" asp-route-id="@item.MaPhim" class="btn btn-warning px-4 fw-semibold">Mua vé</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                </div>
                                <hr class="dropdown-divider">
                                <div class="dropdown-item-text fw-bold text-md">Phim sắp chiếu</div>
                                <div class="row">
                                    @foreach (var item in phimsapchieu)
                                    {
                                        <div class="col-3">
                                            <div class="card h-100 movie-card position-relative overflow-hidden ">
                                                <img src="@item.Poster" class="card-img-top" alt="@item.TenPhim">
                                                <div class="card-body">
                                                    <h5 class="card-title fw-bold">@item.TenPhim</h5>
                                                    <div class="overlay d-flex flex-column justify-content-center align-items-center gap-2 position-absolute top-0 start-0 w-100 h-100">
                                                        <a asp-controller="Phim" asp-action="Index" asp-route-id="@item.MaPhim" class="btn btn-warning px-4 fw-semibold">Mua vé</a>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                </div>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-black" data-bs-toggle="dropdown">Rạp</a>
                            <ul class="dropdown-menu">
                                @foreach(var item in ViewBag.DSRap)
                                {
                                    <li><a class="dropdown-item">@item.TenRap</a></li>
                                }
   
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-black" href="#">Góc Điện Ảnh</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav navbar-expand-sm ms-auto">
                        @{
                            var session = Context.Session.GetString("NguoiDung");
                            if(session == null)
                            {
                                <li>
                                    <a class="nav-link text-black" id="openLogin">Đăng Nhập</a>
                                </li>
                                <li>
                                    <a class="nav-link text-black" id="openRegister">Đăng Ký</a>
                                </li>
                            }
                            else
                            {
                                NguoiDung kh = JsonConvert.DeserializeObject<NguoiDung>(session);
                                <li>
                                    <a asp-action="khachHangProfile" asp-controller="KhachHang" class="nav-link text-black">@kh.HoTen</a>
                                </li>
                                <li>
                                    <a asp-action="DangXuat" asp-controller="KhachHang" class="nav-link text-black">Đăng Xuất</a>
                                </li>
                            }

                        }
                                            
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-black">
        <div class="container text-light">
            &copy; 2025 - XayDungUngDungWEBDatVeXemPhimTrucTuyen - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>

    </footer>

    <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header border-bottom-0">
                    <h1 class="modal-title fs-4 fw-bold text-center w-100">Đăng Ký Tài Khoản</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-3" id="registerContent">
                   
                </div>

            </div>
        </div>
    </div>


    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow">

                <div class="modal-header border-bottom-0">
                    <h1 class="modal-title fs-4 fw-bold text-center w-100" id="loginModalLabel">Đăng Nhập</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4 pt-0" id="loginContent">
                   
                </div>

            </div>
        </div>
    </div>

  
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
                $("#openRegister").on("click", function (e) {
            e.preventDefault();

            $.ajax({
                url: "/KhachHang/DangKy",
                type: "GET",
                success: function (html) {
                    $("#registerContent").html(html);
                    $("#registerModal").modal("show");
                }
            });
        });

          $("#openLogin").on("click", function (e) {
            e.preventDefault();

            $.ajax({
                url: "/KhachHang/DangNhap",
                type: "GET",
                success: function (html) {
                    $("#loginContent").html(html);
                    $("#loginModal").modal("show");
                }
            });
        });

                       $(document).on("submit", "#formDangKy", function (e) {
            e.preventDefault();

            $.ajax({
                url: "/KhachHang/DangKy",
                type: "POST",
                data: $(this).serialize(),
                success: function (response) {

                    // success = true → đóng modal
                    if (response.success) {
                        $("#registerModal").modal("hide");
                        alert("Đăng ký thành công!");
                    }
                    else {
                        // response là HTML → render lại form kèm lỗi
                        $("#registerContent").html(response);
                    }
                }
            });
        });

        $(document).on("submit", "#formDangNhap", function (e) {
            e.preventDefault();

            $.ajax({
                url: "/KhachHang/DangNhap",
                type: "POST",
                data: $(this).serialize(),
                success: function (response) {

                    // success = true → đóng modal
                   if (response.success) {
                $("#loginModal").modal("hide");

                // chuyển hướng sau khi đăng nhập
                window.location.href = response.redirectUrl;

                return;
            }

            // Nếu không success thì response là HTML → cập nhật lại form
            $("#loginContent").html(response);
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<BookingMovieTicket.ViewModels.PhimVM>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const trailerModal = document.getElementById('trailerModal');

        // Lắng nghe khi modal được mở
        trailerModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget; // Nút được click
            const videoUrl = button.getAttribute('data-video');
            const iframe = document.getElementById('trailerFrame');
            iframe.src = videoUrl + "?autoplay=1&mute=1";
        });

        // Lắng nghe khi modal được đóng
        trailerModal.addEventListener('hidden.bs.modal', function () {
            const iframe = document.getElementById('trailerFrame');
            iframe.src = ""; // Dừng video
        });
    });
</script>

@foreach (var item in Model)
{
    <div class="col-6 col-md-4 col-lg-3">
        <div class="gc-movie-card h-100 position-relative">
            <div class="card-img-wrapper">
                <!-- Date badge -->
                @if (item.NgayPhatHanh.HasValue)
                {
                    <span class="gc-date-badge">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @item.NgayPhatHanh.Value.ToString("dd/MM/yyyy")
                    </span>
                }
                <img src="@item.Poster" class="card-img-top" alt="@item.TenPhim">
                <!-- Overlay -->
                <div class="gc-overlay position-absolute top-0 start-0 w-100 h-100">
                    <a asp-controller="Phim" asp-action="Index" asp-route-id="@item.MaPhim" class="btn-buy-ticket">
                        <i class="fas fa-ticket-alt me-1"></i> Mua Vé
                    </a>
                    <a class="btn-trailer" data-bs-toggle="modal" data-bs-target="#trailerModal"
                       data-video="@item.Trailer.Replace("youtu.be/", "www.youtube.com/embed/")">
                        <i class="fas fa-play"></i> Trailer
                    </a>
                </div>
            </div>
            <div class="card-body">
                <h5 class="card-title">@item.TenPhim</h5>
            </div>
        </div>
    </div>
}

<!-- Trailer Modal -->
<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background: #000 !important; border: 1px solid var(--gc-border) !important;">
            <div class="modal-body p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute" style="top: -35px; right: 0; z-index: 10;" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="ratio ratio-16x9">
                    <iframe id="trailerFrame" src="" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

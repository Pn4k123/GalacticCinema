@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm p-5 border-0 rounded-4" style="max-width: 600px; margin: 0 auto;">
        <div class="text-success mb-3">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
        </div>
        <h1 class="fw-bold text-success mb-3">Thanh Toán Thành Công!</h1>
        <p class="text-muted mb-4">Cảm ơn bạn đã đặt vé tại Galactic Cinema. Mã vé đã được gửi đến email của bạn.</p>

        <div class="d-grid gap-2 col-8 mx-auto">
            <a href="/" class="btn btn-primary btn-lg rounded-pill">Về Trang Chủ</a>
            <a asp-controller="KhachHang" asp-action="LichSuGiaoDich" class="btn btn-outline-secondary btn-lg rounded-pill">Xem Lịch Sử Đặt Vé</a>
        </div>
    </div>
</div>
@model BookingMovieTicket.ViewModels.ThanhToanVM
@{
    ViewData["Title"] = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .payment-container {
        max-width: 900px;
        margin: 40px auto;
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .timer-box {
        background: #ffeeba;
        color: #856404;
        padding: 10px;
        text-align: center;
        border-radius: 5px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .method-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        cursor: pointer;
        transition: 0.2s;
        display: flex;
        align-items: center;
        gap: 15px;
        position: relative;
    }

        .method-card:hover {
            background-color: #f8f9fa;
            border-color: #aaa;
        }

        .method-card.active {
            border-color: #007bff;
            background-color: #e7f1ff;
            box-shadow: 0 0 5px rgba(0,123,255,0.3);
        }

            /* Dấu tích xanh khi chọn */
            .method-card.active::after {
                content: '✔';
                position: absolute;
                right: 15px;
                color: #007bff;
                font-weight: bold;
                font-size: 1.2rem;
            }

    .ticket-summary {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        border-left: 5px solid #007bff;
    }
</style>

<div class="container">
    <div class="payment-container">

        <div class="timer-box">
            <i class="fa fa-clock-o"></i> Thời gian giữ ghế còn lại: <span id="countdown" style="font-size: 1.2rem;">10:00</span>
        </div>

        <div class="row">
            <div class="col-md-7">
                <h4 class="mb-4">Chọn phương thức thanh toán</h4>

                <form asp-action="ProcessPayment" method="post" id="paymentForm">
                    <input type="hidden" name="maDon" value="@Model.MaDon" />
                    <input type="hidden" name="phuongThuc" id="selectedMethod" value="ZaloPay" />

                    <div class="method-card active" onclick="selectMethod(this, 'ZaloPay')">
                        <img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Logo-ZaloPay-Square.png" width="50" alt="ZaloPay" style="border-radius: 8px;">
                        <div>
                            <strong>Ví điện tử ZaloPay</strong><br>
                            <small class="text-muted">Thanh toán nhanh chóng qua ứng dụng Zalo</small>
                        </div>
                    </div>

                    <div class="method-card" onclick="selectMethod(this, 'VNPay')">
                        <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/9/06ncktiwd6dc1694418196384.png" width="50" alt="VNPay" style="border-radius: 8px;">
                        <div>
                            <strong>VNPay QR</strong><br>
                            <small class="text-muted">Quét mã QR từ ứng dụng ngân hàng</small>
                        </div>
                    </div>

                    @* <div class="method-card" onclick="selectMethod(this, 'TienMat')">
                        <img src="https://cdn-icons-png.flaticon.com/512/2489/2489756.png" width="50" alt="Cash">
                        <div>
                            <strong>Thanh toán tại quầy</strong><br>
                            <small class="text-muted">Thanh toán trực tiếp khi nhận vé</small>
                        </div>
                    </div> 
                    *@

                    <div class="alert alert-info mt-3">
                        <small><i class="fa fa-info-circle"></i> Bạn sẽ được chuyển hướng sang trang thanh toán của đối tác sau khi nhấn nút bên dưới.</small>
                    </div>

                    <button type="submit" class="btn btn-success w-100 btn-lg mt-3 fw-bold">
                        THANH TOÁN @Model.TongTien.ToString("N0") VNĐ
                    </button>
                </form>
            </div>

            <div class="col-md-5">
                <div class="ticket-summary">
                    <h5 class="text-primary mb-3">Thông tin vé</h5>
                    <h3 style="font-weight: 800">@Model.TenPhim</h3>
                    <hr>
                    <p><strong>Rạp:</strong> @Model.TenRap</p>
                    <p><strong>Phòng:</strong> @Model.TenPhong</p>
                    <p><strong>Suất chiếu:</strong> @Model.SuatChieu</p>
                    <p><strong>Ghế:</strong> <span class="badge bg-success" style="font-size: 1rem">@Model.GheDaChon</span></p>
                    <p><strong>Số lượng:</strong> @Model.SoLuongVe vé</p>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Tổng cộng:</span>
                        <span class="text-danger fs-3 fw-bold">@Model.TongTien.ToString("N0") đ</span>
                    </div>
                </div>
                <a href="/" class="btn btn-outline-secondary w-100 mt-3">Hủy giao dịch</a>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Logic chọn phương thức
    function selectMethod(element, method) {
        // Xóa class active ở tất cả các thẻ
        document.querySelectorAll('.method-card').forEach(el => el.classList.remove('active'));

        // Thêm class active vào thẻ được chọn
        element.classList.add('active');

        // Cập nhật giá trị cho input hidden để gửi về Controller
        document.getElementById('selectedMethod').value = method;
    }

    // 2. Logic đếm ngược (10 phút)
    let time = 10 * 60;
    const countdownEl = document.getElementById('countdown');

    const timer = setInterval(() => {
        const minutes = Math.floor(time / 60);
        let seconds = time % 60;

        seconds = seconds < 10 ? '0' + seconds : seconds;
        countdownEl.innerHTML = `${minutes}:${seconds}`;

        if (time > 0) {
            time--;
        } else {
            clearInterval(timer);
            alert("Hết thời gian giữ ghế! Vui lòng đặt lại.");
            window.location.href = "/";
        }
    }, 1000);
</script>
@model BookingMovieTicket.ViewModels.ThanhToanVM
@{
    ViewData["Title"] = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
       PAYMENT PAGE — Cinema Dark Theme
       ============================================ */

    .gc-payment-page {
        max-width: 960px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    /* --- TIMER --- */
    .gc-timer {
        background: linear-gradient(135deg, rgba(245, 197, 24, 0.12) 0%, rgba(255, 138, 0, 0.08) 100%);
        border: 1px solid rgba(245, 197, 24, 0.25);
        border-radius: var(--gc-radius-md);
        padding: 0.75rem 1.5rem;
        text-align: center;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .gc-timer-icon {
        font-size: 1.1rem;
        color: var(--gc-accent);
        animation: pulse 2s ease-in-out infinite;
    }

    .gc-timer-text {
        color: var(--gc-text-secondary);
        font-weight: 500;
        font-size: 0.9rem;
    }

    .gc-timer-countdown {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--gc-accent);
        font-variant-numeric: tabular-nums;
        min-width: 60px;
    }

    .gc-timer.urgent {
        border-color: rgba(255, 71, 87, 0.4);
        background: linear-gradient(135deg, rgba(255, 71, 87, 0.12) 0%, rgba(255, 71, 87, 0.06) 100%);
    }

    .gc-timer.urgent .gc-timer-countdown,
    .gc-timer.urgent .gc-timer-icon {
        color: var(--gc-danger);
    }

    /* --- PAYMENT METHOD SECTION --- */
    .gc-payment-section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--gc-text-primary);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .gc-payment-section-title i {
        color: var(--gc-cyan);
    }

    /* --- METHOD CARDS --- */
    .gc-method-card {
        background: var(--gc-bg-card);
        border: 1.5px solid var(--gc-border);
        border-radius: var(--gc-radius-md);
        padding: 1rem 1.25rem;
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 1rem;
        position: relative;
        overflow: hidden;
    }

    .gc-method-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: transparent;
        transition: background 0.3s ease;
    }

    .gc-method-card:hover {
        border-color: rgba(0, 212, 255, 0.3);
        background: var(--gc-bg-card-hover);
    }

    .gc-method-card.active {
        border-color: var(--gc-cyan);
        background: rgba(0, 212, 255, 0.06);
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.1);
    }

    .gc-method-card.active::before {
        background: var(--gc-cyan);
    }

    .gc-method-card.active::after {
        content: '✓';
        position: absolute;
        right: 1rem;
        width: 26px;
        height: 26px;
        background: var(--gc-cyan);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gc-bg-primary);
        font-weight: 900;
        font-size: 0.75rem;
    }

    .gc-method-logo {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        object-fit: contain;
        background: #fff;
        padding: 4px;
        flex-shrink: 0;
    }

    .gc-method-info {
        flex: 1;
    }

    .gc-method-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--gc-text-primary);
        margin-bottom: 0.15rem;
    }

    .gc-method-desc {
        font-size: 0.8rem;
        color: var(--gc-text-muted);
    }

    /* --- INFO ALERT --- */
    .gc-payment-info {
        background: rgba(0, 212, 255, 0.06);
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: var(--gc-radius-sm);
        padding: 0.75rem 1rem;
        margin-top: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .gc-payment-info i {
        color: var(--gc-cyan);
        margin-top: 2px;
        flex-shrink: 0;
    }

    .gc-payment-info span {
        color: var(--gc-text-secondary);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    /* --- PAY BUTTON --- */
    .gc-btn-pay-main {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: var(--gc-radius-md);
        background: linear-gradient(135deg, #00d4ff 0%, #0099cc 50%, #006699 100%);
        background-size: 200% 200%;
        color: #fff;
        font-weight: 800;
        font-size: 1.05rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .gc-btn-pay-main::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        transition: left 0.5s ease;
    }

    .gc-btn-pay-main:hover::before {
        left: 100%;
    }

    .gc-btn-pay-main:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 212, 255, 0.35);
    }

    /* --- TICKET SUMMARY (RIGHT SIDE) --- */
    .gc-ticket-summary {
        background: var(--gc-bg-card);
        border: 1px solid var(--gc-border);
        border-radius: var(--gc-radius-lg);
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .gc-ticket-summary::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--gc-cyan), var(--gc-accent));
    }

    .gc-ticket-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 800;
        color: var(--gc-cyan);
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--gc-border);
    }

    .gc-ticket-movie-name {
        font-size: 1.15rem;
        font-weight: 900;
        color: var(--gc-text-primary);
        margin-bottom: 1rem;
        line-height: 1.3;
    }

    .gc-ticket-divider {
        border: none;
        height: 1px;
        background: var(--gc-border);
        margin: 1rem 0;
        position: relative;
    }

    /* Ticket punch-hole effect */
    .gc-ticket-divider::before,
    .gc-ticket-divider::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 16px;
        height: 16px;
        background: var(--gc-bg-primary);
        border-radius: 50%;
        transform: translateY(-50%);
    }

    .gc-ticket-divider::before {
        left: -24px;
    }

    .gc-ticket-divider::after {
        right: -24px;
    }

    .gc-ticket-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
    }

    .gc-ticket-label {
        color: var(--gc-text-muted);
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .gc-ticket-label i {
        font-size: 0.8rem;
        color: var(--gc-text-muted);
    }

    .gc-ticket-value {
        color: var(--gc-text-primary);
        font-size: 0.85rem;
        font-weight: 600;
        text-align: right;
    }

    /* Seat tags */
    .gc-ticket-seats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        justify-content: flex-end;
    }

    .gc-ticket-seat-tag {
        background: rgba(0, 212, 255, 0.12);
        border: 1px solid rgba(0, 212, 255, 0.3);
        color: var(--gc-cyan);
        padding: 0.15rem 0.55rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    /* Total row */
    .gc-ticket-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0 0;
    }

    .gc-ticket-total-label {
        font-size: 1rem;
        font-weight: 700;
        color: var(--gc-text-primary);
    }

    .gc-ticket-total-price {
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--gc-accent);
    }

    /* Cancel button */
    .gc-btn-cancel {
        width: 100%;
        padding: 0.65rem;
        border: 1px solid var(--gc-border);
        border-radius: var(--gc-radius-md);
        background: transparent;
        color: var(--gc-text-muted);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        margin-top: 0.75rem;
        text-decoration: none;
        display: block;
    }

    .gc-btn-cancel:hover {
        border-color: var(--gc-danger);
        color: var(--gc-danger);
        background: rgba(255, 71, 87, 0.06);
    }

    /* --- SECURE BADGES --- */
    .gc-secure-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--gc-border);
    }

    .gc-secure-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--gc-text-muted);
        font-size: 0.75rem;
        font-weight: 500;
    }

    .gc-secure-item i {
        color: var(--gc-success);
        font-size: 0.8rem;
    }
</style>

<div class="gc-payment-page">

    <!-- Timer -->
    <div class="gc-timer" id="timerBox">
        <i class="fas fa-clock gc-timer-icon"></i>
        <span class="gc-timer-text">Thời gian giữ ghế còn lại:</span>
        <span class="gc-timer-countdown" id="countdown">10:00</span>
    </div>

    <div class="row g-4">
        <!-- ========== LEFT: Payment Methods ========== -->
        <div class="col-lg-7">
            <h4 class="gc-payment-section-title">
                <i class="fas fa-wallet"></i> Chọn phương thức thanh toán
            </h4>

            <form asp-action="ProcessPayment" method="post" id="paymentForm">
                <input type="hidden" name="maDon" value="@Model.MaDon" />
                <input type="hidden" name="phuongThuc" id="selectedMethod" value="ZaloPay" />

                <!-- ZaloPay -->
                <div class="gc-method-card active" onclick="selectMethod(this, 'ZaloPay')">
                    <img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Logo-ZaloPay-Square.png" class="gc-method-logo" alt="ZaloPay">
                    <div class="gc-method-info">
                        <div class="gc-method-name">Ví điện tử ZaloPay</div>
                        <div class="gc-method-desc">Thanh toán nhanh chóng qua ứng dụng Zalo</div>
                    </div>
                </div>

                <!-- VNPay -->
                <div class="gc-method-card" onclick="selectMethod(this, 'VNPay')">
                    <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/9/06ncktiwd6dc1694418196384.png" class="gc-method-logo" alt="VNPay">
                    <div class="gc-method-info">
                        <div class="gc-method-name">VNPay QR</div>
                        <div class="gc-method-desc">Quét mã QR từ ứng dụng ngân hàng</div>
                    </div>
                </div>

                <!-- Info -->
                <div class="gc-payment-info">
                    <i class="fas fa-shield-alt"></i>
                    <span>Bạn sẽ được chuyển hướng sang trang thanh toán bảo mật của đối tác sau khi nhấn nút bên dưới. Thông tin của bạn được bảo vệ an toàn.</span>
                </div>

                <!-- Pay Button -->
                <button type="submit" class="gc-btn-pay-main">
                    <i class="fas fa-lock"></i>
                    THANH TOÁN @Model.TongTien.ToString("N0") VNĐ
                </button>
            </form>

            <!-- Secure badges -->
            <div class="gc-secure-row">
                <div class="gc-secure-item">
                    <i class="fas fa-check-circle"></i> SSL Encrypted
                </div>
                <div class="gc-secure-item">
                    <i class="fas fa-check-circle"></i> Thanh toán an toàn
                </div>
                <div class="gc-secure-item">
                    <i class="fas fa-check-circle"></i> Bảo mật 100%
                </div>
            </div>
        </div>

        <!-- ========== RIGHT: Ticket Summary ========== -->
        <div class="col-lg-5">
            <div class="gc-ticket-summary">
                <div class="gc-ticket-header">
                    <i class="fas fa-ticket-alt"></i> Thông tin vé
                </div>

                <h4 class="gc-ticket-movie-name">@Model.TenPhim</h4>

                <hr class="gc-ticket-divider" />

                <div class="gc-ticket-row">
                    <span class="gc-ticket-label"><i class="fas fa-building"></i> Rạp</span>
                    <span class="gc-ticket-value" style="color: var(--gc-cyan);">@Model.TenRap</span>
                </div>
                <div class="gc-ticket-row">
                    <span class="gc-ticket-label"><i class="fas fa-door-open"></i> Phòng</span>
                    <span class="gc-ticket-value">@Model.TenPhong</span>
                </div>
                <div class="gc-ticket-row">
                    <span class="gc-ticket-label"><i class="fas fa-clock"></i> Suất chiếu</span>
                    <span class="gc-ticket-value" style="color: var(--gc-cyan);">@Model.SuatChieu</span>
                </div>
                <div class="gc-ticket-row">
                    <span class="gc-ticket-label"><i class="fas fa-couch"></i> Ghế</span>
                    <div class="gc-ticket-seats">
                        @foreach (var ghe in Model.GheDaChon.Split(", "))
                        {
                            <span class="gc-ticket-seat-tag">@ghe</span>
                        }
                    </div>
                </div>
                <div class="gc-ticket-row">
                    <span class="gc-ticket-label"><i class="fas fa-ticket-alt"></i> Số lượng</span>
                    <span class="gc-ticket-value">@Model.SoLuongVe vé</span>
                </div>

                <hr class="gc-ticket-divider" />

                <div class="gc-ticket-total">
                    <span class="gc-ticket-total-label">Tổng cộng</span>
                    <span class="gc-ticket-total-price">@Model.TongTien.ToString("N0") đ</span>
                </div>
            </div>

            <a href="/" class="gc-btn-cancel">
                <i class="fas fa-times me-1"></i> Hủy giao dịch
            </a>
        </div>
    </div>
</div>

<script>
    // 1. Select payment method
    function selectMethod(element, method) {
        document.querySelectorAll('.gc-method-card').forEach(el => el.classList.remove('active'));
        element.classList.add('active');
        document.getElementById('selectedMethod').value = method;
    }

    // 2. Countdown timer (10 minutes)
    let time = 10 * 60;
    const countdownEl = document.getElementById('countdown');
    const timerBox = document.getElementById('timerBox');

    const timer = setInterval(() => {
        const minutes = Math.floor(time / 60);
        let seconds = time % 60;
        seconds = seconds < 10 ? '0' + seconds : seconds;
        countdownEl.innerHTML = `${minutes}:${seconds}`;

        // Urgent mode when < 2 minutes
        if (time <= 120) {
            timerBox.classList.add('urgent');
        }

        if (time > 0) {
            time--;
        } else {
            clearInterval(timer);
            alert("Hết thời gian giữ ghế! Vui lòng đặt lại.");
            window.location.href = "/";
        }
    }, 1000);
</script>
@{
    ViewData["Title"] = "Lỗi Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .gc-error-page {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .gc-error-card {
        max-width: 520px;
        width: 100%;
        background: var(--gc-bg-card);
        border: 1px solid var(--gc-border);
        border-radius: var(--gc-radius-xl);
        padding: 3rem 2.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .gc-error-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--gc-danger), #ff6b81);
    }

    .gc-error-icon-wrapper {
        width: 90px;
        height: 90px;
        margin: 0 auto 1.5rem;
        background: rgba(255, 71, 87, 0.1);
        border: 2px solid rgba(255, 71, 87, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: errorShake 0.6s ease;
    }

    .gc-error-icon-wrapper i {
        font-size: 2.5rem;
        color: var(--gc-danger);
    }

    @@keyframes errorShake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-10px); }
        40% { transform: translateX(10px); }
        60% { transform: translateX(-6px); }
        80% { transform: translateX(6px); }
    }

    .gc-error-title {
        font-size: 1.6rem;
        font-weight: 900;
        color: var(--gc-danger);
        margin-bottom: 0.75rem;
    }

    .gc-error-desc {
        color: var(--gc-text-secondary);
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 0.75rem;
    }

    .gc-error-message {
        background: rgba(255, 71, 87, 0.08);
        border: 1px solid rgba(255, 71, 87, 0.2);
        border-radius: var(--gc-radius-sm);
        padding: 0.75rem 1rem;
        color: var(--gc-text-secondary);
        font-size: 0.85rem;
        margin-bottom: 2rem;
    }

    .gc-btn-retry {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem 2rem;
        border: none;
        border-radius: var(--gc-radius-md);
        background: linear-gradient(135deg, var(--gc-cyan), #0099cc);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .gc-btn-retry:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 212, 255, 0.3);
        color: #fff;
    }
</style>

<div class="gc-error-page">
    <div class="gc-error-card">
        <div class="gc-error-icon-wrapper">
            <i class="fas fa-times"></i>
        </div>

        <h1 class="gc-error-title">Rất Tiếc!</h1>
        <p class="gc-error-desc">Thanh toán không thành công.</p>

        <div class="gc-error-message">
            <i class="fas fa-info-circle me-1"></i> @ViewBag.Message
        </div>

        <p class="gc-error-desc" style="margin-bottom: 1.5rem;">Vui lòng thực hiện đặt vé lại từ đầu.</p>

        <a href="/" class="gc-btn-retry">
            <i class="fas fa-home"></i> Về Trang Chủ
        </a>
    </div>
</div>
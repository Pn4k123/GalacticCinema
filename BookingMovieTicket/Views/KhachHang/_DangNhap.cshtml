@model BookingMovieTicket.ViewModels.DangNhapVM
@{
    Layout = null;
}

<form asp-action="DangNhap" asp-route-returnurl="@ViewBag.ReturnUrl" method="post" id="formDangNhap">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-floating mb-3">
        <input asp-for="Email" type="email" class="form-control rounded-3" >
        <label asp-for="Email"></label>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="MatKhau" type="password" class="form-control rounded-3">
        <label asp-for="MatKhau" ></label>
        <span asp-validation-for="MatKhau" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="" id="rememberMe">
            <label class="form-check-label text-secondary small" for="rememberMe">
                Ghi nhớ đăng nhập
            </label>
        </div>
        <a asp-controller="KhachHang" asp-action="quenMatKhau" class="text-decoration-none small">Quên mật khẩu?</a>
    </div>

    <button class="w-100 mb-2 btn btn-lg rounded-3 btn-primary" type="submit">Đăng nhập</button>

    <div class="text-center mt-3">
        <span class="text-muted small">Chưa có tài khoản?</span>
        <a href="#" class="text-decoration-none fw-bold small" data-bs-toggle="modal" data-bs-target="#registerModal">Đăng ký ngay</a>
    </div>

    <hr class="my-4">
    <h2 class="fs-5 fw-bold mb-3 text-center">Hoặc đăng nhập bằng</h2>
    <button class="w-100 py-2 mb-2 btn btn-outline-dark rounded-3" type="button">
        <i class="bi bi-google me-2"></i> Google
    </button>
    <button class="w-100 py-2 mb-2 btn btn-outline-primary rounded-3" type="button">
        <i class="bi bi-facebook me-2"></i> Facebook
    </button>
</form>
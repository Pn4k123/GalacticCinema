{
  "ConnectionStrings": {
    "MovieData": "#{MOVIE_DB_CONNECTION}#"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "VnPay": {
    "TmnCode": "#{VNPAY_TMN_CODE}#",
    "HashSecret": "#{VNPAY_HASH_SECRET}#",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Command": "pay",
    "CurrCode": "VND",
    "Version": "2.1.0",
    "Locale": "vn",
    "PaymentBackReturnUrl": "#{VNPAY_RETURN_URL}#"
  },

  "EmailSettings": {
    "Mail": "#{EMAIL_ADDRESS}#",
    "DisplayName": "Galactic Cinema",
    "Password": "#{EMAIL_PASSWORD}#",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": "true"
  },

  "ZaloPay": {
    "AppId": "#{ZALOPAY_APP_ID}#",
    "Key1": "#{ZALOPAY_KEY1}#",
    "Key2": "#{ZALOPAY_KEY2}#",
    "ApiUrl": "https://sb-openapi.zalopay.vn/v2/create",
    "RedirectUrl": "#{ZALOPAY_REDIRECT_URL}#"
  },

  "AllowedHosts": "*"
}